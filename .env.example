# Copy to .env and fill in. .env is gitignored — never commit real values.
# See docs/architecture.md Appendix B.

# ── database (Neon) ───────────────────────────────────────────────────────────
# Pooled connection (pgBouncer) — used by the app at runtime.
#
# ⚠️ MEASURED 2026-08-20: on Neon, the -pooler endpoint cost ~1146ms per query
# from a remote dev machine versus ~231ms direct — about four extra network
# hops on EVERY query. For local development, point DATABASE_URL at the DIRECT
# endpoint instead; a long-running API with Prisma's own pool does not need
# pgBouncer. Serverless deployments (one connection per invocation) DO need it,
# so re-measure rather than carrying the dev setting into production.
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/wherepreds?sslmode=require&pgbouncer=true"
# Direct connection — used by `prisma migrate` ONLY. Migrations cannot run
# through pgBouncer.
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/wherepreds?sslmode=require"
# Optional read replica for long analytical reads (Phase 7).
READ_REPLICA_URL=""

# ── redis (queues, cache, rate limits) ────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── auth ──────────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_PRIVATE_KEY=""

# ── football data: football-data.org v4 ───────────────────────────────────────
# Register at https://www.football-data.org/client/register
FOOTBALL_PROVIDER="football-data-org"
FOOTBALL_API_TOKEN=""
FOOTBALL_API_BASE="https://api.football-data.org/v4"

# Must match the purchased plan. Free = 10, Free w/ Livescores = 20,
# Free + Deep Data = 30, Standard = 60.
FOOTBALL_RATE_LIMIT_PER_MIN="10"

# Capability flags — see docs/architecture.md §11.5.
# Deep Data (EUR 29/mo) unlocks goals[], bookings[], substitutions, lineups,
# squads. Without it, goalscorer and red-card markets are gated off and
# PlayerMatchStat cannot be derived.
FOOTBALL_CAP_DEEP_DATA="false"
# Statistic add-on (EUR 15/mo) unlocks corners, shots, possession.
# Deliberately not bought for v1 — gates TOTAL_CORNERS_OVER_UNDER.
FOOTBALL_CAP_STATISTICS="false"

# Competition codes we ingest. Verified live 2026-08-18: all six are on the
# Free 12-competition tier. PL=2021 PD=2014 SA=2019 BL1=2002 FL1=2015 CL=2001
FOOTBALL_COMPETITIONS="PL,PD,SA,BL1,FL1,CL"

# ── app ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"
API_PORT="4000"
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:5173"
