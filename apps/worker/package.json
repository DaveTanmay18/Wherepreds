{
  "name": "@wp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "dotenv -e ../../.env -- tsx src/cli.ts",
    "test": "dotenv -e ../../.env -- cross-env LOG_LEVEL=silent vitest run"
  },
  "dependencies": {
    "@wp/db": "workspace:*",
    "@wp/shared": "workspace:*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "@wp/scoring": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@wp/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "cross-env": "^7.0.3",
    "vitest": "^3.0.4"
  }
}
