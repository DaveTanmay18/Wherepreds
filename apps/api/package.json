{
  "name": "@wp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- cross-env LOG_LEVEL=silent vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@wp/db": "workspace:*",
    "@wp/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1",
    "@wp/scoring": "workspace:*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^6.0.2",
    "@wp/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "pino-pretty": "^13.0.0",
    "cross-env": "^7.0.3"
  }
}
